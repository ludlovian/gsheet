{
  "name": "@ludlovian/gsheet",
  "version": "0.4.3",
  "description": "Simple google sheets API",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "clean": "rm -rf coverage/ node_modules/.cache/",
    "lint": "standard '{src,test}/**/*.js'|snazzy",
    "format": "prettier-standard '{src,test}/**/*.js'",
    "test": "c8 node --env-file .env --test",
    "coverage": "npm run test && c8 report --reporter=html && sirv coverage/ -p 8000 -H"
  },
  "dependencies": {
    "@ludlovian/configure": "file:../configure",
    "@ludlovian/debug": "file:../debug",
    "@ludlovian/jeeves": "file:../jeeves"
  }
}
